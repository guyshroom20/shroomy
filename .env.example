# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses row-level security; used by the verification webhooks.
SUPABASE_SECRET_KEY=sb_secret_...

# For the Supabase CLI (npm run db:link / db:push / db:types)
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Verification providers: "stub" until contracts are signed.
ID_VERIFICATION_PROVIDER=stub
AGE_ASSURANCE_PROVIDER=stub
# The stub refuses to run in production unless this is true (e.g. on a staging deploy).
ALLOW_STUB_VERIFICATION=false

# Advertiser ID checks: Yoti Hub → Identity Verification. Use one of the two key settings.
YOTI_CLIENT_SDK_ID=
YOTI_KEY_FILE_PATH=./keys/yoti.pem
# YOTI_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Sandbox only:
# YOTI_IDV_API_URL=https://api.yoti.com/sandbox/idverify/v1

# Visitor age checks: VerifyMy dashboard. Register <site>/api/verification/return/verifymy as a redirect URL.
VERIFYMY_API_KEY=
VERIFYMY_API_SECRET=
VERIFYMY_BUSINESS_SETTINGS_ID=
# Sandbox only:
# VERIFYMY_API_URL=https://sandbox.verifymyage.com

# A long random string (openssl rand -hex 32). Yoti sends it back with each webhook.
VERIFICATION_WEBHOOK_SECRET=
# A long random string. Phone numbers and device ids are stored only as hashes under this key.
SIGNAL_HASH_SECRET=
